<%- include('partials/header') %>
<div class="mb-6 flex justify-between items-center">
    <h1 class="text-2xl font-semibold text-ink-900 tracking-tight">Historial de Pedidos Entregados</h1>
</div>

<!-- Summary Cards -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
    <!-- Card: Total de Etiquetas General -->
    <div class="panel bg-panel border border-ink-300 rounded-lg shadow-subtle p-6 flex items-center justify-between">
        <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-ink-500 block mb-1">Total de Etiquetas General</span>
            <span class="text-3xl font-bold text-ink-900"><%= totalEtiquetasGeneral.toLocaleString('es-ES') %></span>
        </div>
        <div class="p-3 bg-brand-50 dark:bg-brand-200/10 rounded-full text-brand-600 dark:text-brand-500">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
        </div>
    </div>

    <!-- Card: Total de Etiquetas Con Mano de Obra -->
    <div class="panel bg-panel border border-ink-300 rounded-lg shadow-subtle p-6 flex items-center justify-between">
        <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-ink-500 block mb-1">Total de Etiquetas Con Mano de Obra</span>
            <span class="text-3xl font-bold text-brand-600"><%= totalEtiquetasLabor.toLocaleString('es-ES') %></span>
        </div>
        <div class="p-3 bg-amber-50 dark:bg-amber-950/20 rounded-full text-amber-600 dark:text-amber-500">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
        </div>
    </div>

    <!-- Card: Etiqueta más pedida -->
    <div class="panel bg-panel border border-ink-300 rounded-lg shadow-subtle p-6 flex items-center justify-between">
        <div class="min-w-0 flex-1 pr-4">
            <span class="text-xs font-semibold uppercase tracking-wider text-ink-500 block mb-1">Etiqueta más pedida</span>
            <span class="text-xl font-bold text-ink-900 truncate block" title="<%= mostRequestedProduct %>">
                <%= mostRequestedProduct %>
            </span>
            <% if (mostRequestedQty > 0) { %>
                <span class="text-xs text-ink-500 mt-1 block">Con <strong class="text-ink-900"><%= mostRequestedQty.toLocaleString('es-ES') %></strong> unidades</span>
            <% } %>
        </div>
        <div class="p-3 bg-brand-50 dark:bg-brand-200/10 rounded-full text-brand-600 dark:text-brand-500 flex-shrink-0">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.907c.961 0 1.36 1.243.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.773-.567-.374-1.81.588-1.81h4.907a1 1 0 00.95-.69l1.519-4.674z"></path>
            </svg>
        </div>
    </div>
</div>

<%
  let qs = [];
  if (filters.start_date) qs.push('start_date=' + filters.start_date);
  if (filters.end_date) qs.push('end_date=' + filters.end_date);
  if (filters.product_id) qs.push('product_id=' + filters.product_id);
  if (filters.branch_id) qs.push('branch_id=' + filters.branch_id);
  if (filters.group_by) qs.push('group_by=' + filters.group_by);
  let queryString = qs.join('&');
  
  let individualQs = [];
  if (filters.start_date) individualQs.push('start_date=' + filters.start_date);
  if (filters.end_date) individualQs.push('end_date=' + filters.end_date);
  if (filters.product_id) individualQs.push('product_id=' + filters.product_id);
  if (filters.branch_id) individualQs.push('branch_id=' + filters.branch_id);
  let individualQueryString = individualQs.join('&');
%>

<div class="grid grid-cols-1 gap-6">
    <!-- Filter Panel -->
    <div class="panel bg-panel border border-ink-300 rounded-lg shadow-subtle p-6">
        <h2 class="text-sm font-medium text-ink-900 mb-4">Filtrar Pedidos</h2>
        <form action="/history" method="GET" class="grid grid-cols-1 md:grid-cols-2 <%= user.is_admin ? 'lg:grid-cols-5' : 'lg:grid-cols-4' %> gap-4 items-end">
            <input type="hidden" name="group_by" value="<%= filters.group_by || 'false' %>">
            <div>
                <label class="block text-xs font-medium text-ink-500 mb-1">Fecha Desde</label>
                <input type="date" name="start_date" value="<%= filters.start_date || '' %>" class="input-minimal">
            </div>
            <div>
                <label class="block text-xs font-medium text-ink-500 mb-1">Fecha Hasta</label>
                <input type="date" name="end_date" value="<%= filters.end_date || '' %>" class="input-minimal">
            </div>
            <div>
                <label class="block text-xs font-medium text-ink-500 mb-1">Tipo de Etiqueta (Producto)</label>
                <select name="product_id" id="product_id_filter" class="w-full font-medium">
                    <option value="">Todos los productos</option>
                    <% products.forEach(p => { %>
                        <option value="<%= p.id %>" <%= filters.product_id == p.id ? 'selected' : '' %>><%= p.name %></option>
                    <% }) %>
                </select>
            </div>
            <% if (user.is_admin) { %>
                <div>
                    <label class="block text-xs font-medium text-ink-500 mb-1">Sucursal</label>
                    <select name="branch_id" class="input-minimal cursor-pointer">
                        <option value="global">Todas (Global)</option>
                        <% branches.forEach(b => { %>
                            <option value="<%= b.id %>" <%= filters.branch_id == b.id ? 'selected' : '' %>><%= b.name %></option>
                        <% }) %>
                    </select>
                </div>
            <% } %>
            <div class="flex gap-2 flex-wrap">
                <button type="submit" class="flex-grow btn-minimal !py-2">Filtrar</button>
                <a href="/history" class="flex-grow btn-outline text-center !py-2">Limpiar</a>
                
                <% if (filters.group_by === 'true') { %>
                    <a href="/history?<%= individualQueryString ? individualQueryString + '&' : '' %>group_by=false" class="flex-grow btn-minimal !bg-amber-600 hover:!bg-amber-700 text-center !py-2" title="Mostrar listado individual de pedidos">
                        📄 Vista Individual
                    </a>
                <% } else { %>
                    <a href="/history?<%= individualQueryString ? individualQueryString + '&' : '' %>group_by=true" class="flex-grow btn-minimal !bg-indigo-600 hover:!bg-indigo-700 text-center !py-2" title="Agrupar pedidos entregados por etiquetas">
                        📊 Agrupar por etiquetas
                    </a>
                <% } %>
                
                <a href="/history?<%= queryString %>&export=csv" class="flex-grow btn-minimal !bg-emerald-600 hover:!bg-emerald-700 text-center !py-2 flex items-center justify-center gap-1.5" title="Exportar resultados a CSV">
                    📥 Exportar CSV
                </a>
            </div>
        </form>
    </div>

    <!-- History Directory Panel -->
    <div class="panel p-0 overflow-hidden bg-panel border border-ink-300 rounded-lg shadow-subtle">
        <div class="px-6 py-4 border-b border-ink-300">
            <h3 class="text-sm font-medium text-ink-900">
                <%= filters.group_by === 'true' ? 'Consolidado de Cantidades por Etiqueta' : 'Listado de Entregas' %>
            </h3>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-ink-300" id="history-table">
                <% if (filters.group_by === 'true') { %>
                    <thead class="bg-surface">
                        <tr>
                            <th class="px-6 py-3 text-left text-[11px] font-semibold text-ink-500 uppercase tracking-wider cursor-pointer select-none" onclick="sortTableGrouped(0)">
                                Etiqueta <span id="sort-arrow-0" class="ml-1 text-[9px] text-ink-400">↕</span>
                            </th>
                            <th class="px-6 py-3 text-left text-[11px] font-semibold text-ink-500 uppercase tracking-wider cursor-pointer select-none" onclick="sortTableGrouped(1)">
                                Cantidad Total <span id="sort-arrow-1" class="ml-1 text-[9px] text-ink-400">↕</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="bg-panel divide-y divide-ink-300">
                        <% if (orders.length === 0) { %>
                            <tr>
                                <td colspan="2" class="px-6 py-8 text-center text-sm text-ink-500 italic">No se encontraron entregas agrupadas con los filtros aplicados.</td>
                            </tr>
                        <% } %>
                        <% orders.forEach(row => { %>
                            <tr class="hover:bg-surface transition-colors">
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-ink-900">
                                    <%= row.product_name %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-ink-900">
                                    <%= row.total_quantity %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                <% } else { %>
                    <thead class="bg-surface">
                        <tr>
                            <th class="px-6 py-3 text-left text-[11px] font-semibold text-ink-500 uppercase tracking-wider cursor-pointer select-none" onclick="sortTable(0)">
                                ID <span id="sort-arrow-0" class="ml-1 text-[9px] text-ink-400">↕</span>
                            </th>
                            <th class="px-6 py-3 text-left text-[11px] font-semibold text-ink-500 uppercase tracking-wider cursor-pointer select-none" onclick="sortTable(1)">
                                Etiqueta <span id="sort-arrow-1" class="ml-1 text-[9px] text-ink-400">↕</span>
                            </th>
                            <th class="px-6 py-3 text-left text-[11px] font-semibold text-ink-500 uppercase tracking-wider cursor-pointer select-none" onclick="sortTable(2)">
                                Cantidad de Etiquetas <span id="sort-arrow-2" class="ml-1 text-[9px] text-ink-400">↕</span>
                            </th>
                            <th class="px-6 py-3 text-left text-[11px] font-semibold text-ink-500 uppercase tracking-wider cursor-pointer select-none" onclick="sortTable(3)">
                                Mano de Obra <span id="sort-arrow-3" class="ml-1 text-[9px] text-ink-400">↕</span>
                            </th>
                            <th class="px-6 py-3 text-left text-[11px] font-semibold text-ink-500 uppercase tracking-wider cursor-pointer select-none" onclick="sortTable(4)">
                                Fecha Ingreso <span id="sort-arrow-4" class="ml-1 text-[9px] text-ink-400">↕</span>
                            </th>
                            <th class="px-6 py-3 text-left text-[11px] font-semibold text-ink-500 uppercase tracking-wider cursor-pointer select-none" onclick="sortTable(5)">
                                Fecha Entrega <span id="sort-arrow-5" class="ml-1 text-[9px] text-ink-400">↕</span>
                            </th>
                            <th class="px-6 py-3 text-left text-[11px] font-semibold text-ink-500 uppercase tracking-wider cursor-pointer select-none" onclick="sortTable(6)">
                                Diseño <span id="sort-arrow-6" class="ml-1 text-[9px] text-ink-400">↕</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="bg-panel divide-y divide-ink-300">
                        <% if (orders.length === 0) { %>
                            <tr>
                                <td colspan="7" class="px-6 py-8 text-center text-sm text-ink-500 italic">No se encontraron entregas con los filtros aplicados.</td>
                            </tr>
                        <% } %>
                        <% orders.forEach(order => { %>
                            <tr class="hover:bg-surface transition-colors">
                                <td class="px-6 py-4 whitespace-nowrap text-xs font-mono text-ink-500">#<%= order.id %></td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm font-medium text-ink-900"><%= order.product_name %></div>
                                    <% if (order.tags) { %>
                                        <div class="text-[10px] font-medium text-brand-600 mt-0.5"><%= order.tags %></div>
                                    <% } %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-xs font-semibold text-ink-900">
                                    <%= order.quantity %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <% if (user.is_admin) { %>
                                        <label class="relative inline-flex items-center cursor-pointer">
                                            <input type="checkbox" 
                                                   class="sr-only peer labor-toggle" 
                                                   data-id="<%= order.id %>" 
                                                   <%= order.labor ? 'checked' : '' %>>
                                            <div class="w-9 h-5 bg-ink-300 peer-focus:outline-none rounded-full peer dark:bg-zinc-800 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-brand-600"></div>
                                            <span class="ml-2 text-xs text-ink-700 peer-checked:text-brand-600 font-medium peer-checked:font-semibold">
                                                <%= order.labor ? 'Sí' : 'No' %>
                                            </span>
                                        </label>
                                    <% } else { %>
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= order.labor ? 'bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300' : 'bg-ink-100 text-ink-600 dark:bg-zinc-800' %>">
                                            <%= order.labor ? 'Mano de Obra' : 'No' %>
                                        </span>
                                    <% } %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-xs text-ink-500">
                                    <%= new Date(order.order_date).toLocaleDateString('es-ES', { timeZone: 'America/Guatemala' }) %> a las <%= new Date(order.order_date).toLocaleTimeString('es-ES', { timeZone: 'America/Guatemala', hour: '2-digit', minute:'2-digit' }) %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-xs text-ink-500">
                                    <%= new Date(order.updated_at).toLocaleDateString('es-ES', { timeZone: 'America/Guatemala' }) %> a las <%= new Date(order.updated_at).toLocaleTimeString('es-ES', { timeZone: 'America/Guatemala', hour: '2-digit', minute:'2-digit' }) %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <% if (order.image_path) { %>
                                        <a href="<%= order.image_path %>" target="_blank" class="text-xs text-brand-600 hover:text-brand-850 hover:underline transition-colors font-medium">Diseño</a>
                                    <% } else { %>
                                        <span class="text-xs text-ink-400">-</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                <% } %>
            </table>
        </div>
    </div>
</div>

<script>
    let sortDirections = {};

    function sortTable(colIndex) {
        const table = document.getElementById("history-table");
        const tbody = table.querySelector("tbody");
        const rows = Array.from(tbody.querySelectorAll("tr"));
        
        if (rows.length === 1 && rows[0].cells.length === 1) return;
        
        let dir = sortDirections[colIndex] === 'asc' ? 'desc' : 'asc';
        sortDirections = {};
        sortDirections[colIndex] = dir;
        
        for (let i = 0; i <= 6; i++) {
            const arrow = document.getElementById("sort-arrow-" + i);
            if (arrow) arrow.textContent = "↕";
        }
        
        document.getElementById("sort-arrow-" + colIndex).textContent = dir === 'asc' ? "▲" : "▼";
        
        rows.sort((a, b) => {
            let valA = getCellValue(a, colIndex);
            let valB = getCellValue(b, colIndex);
            
            if (colIndex === 0) {
                const idA = parseInt(valA.replace('#', '')) || 0;
                const idB = parseInt(valB.replace('#', '')) || 0;
                return dir === 'asc' ? idA - idB : idB - idA;
            } else if (colIndex === 2) {
                const qtyA = parseFloat(valA) || 0;
                const qtyB = parseFloat(valB) || 0;
                return dir === 'asc' ? qtyA - qtyB : qtyB - qtyA;
            } else if (colIndex === 4 || colIndex === 5) {
                const dateA = parseCustomDate(valA);
                const dateB = parseCustomDate(valB);
                return dir === 'asc' ? dateA - dateB : dateB - dateA;
            } else {
                return dir === 'asc'
                    ? valA.localeCompare(valB)
                    : valB.localeCompare(valA);
            }
        });
        
        tbody.innerHTML = "";
        rows.forEach(row => tbody.appendChild(row));
    }

    function sortTableGrouped(colIndex) {
        const table = document.getElementById("history-table");
        const tbody = table.querySelector("tbody");
        const rows = Array.from(tbody.querySelectorAll("tr"));
        
        if (rows.length === 1 && rows[0].cells.length === 1) return;
        
        let dir = sortDirections[colIndex] === 'asc' ? 'desc' : 'asc';
        sortDirections = {};
        sortDirections[colIndex] = dir;
        
        for (let i = 0; i <= 1; i++) {
            const arrow = document.getElementById("sort-arrow-" + i);
            if (arrow) arrow.textContent = "↕";
        }
        
        document.getElementById("sort-arrow-" + colIndex).textContent = dir === 'asc' ? "▲" : "▼";
        
        rows.sort((a, b) => {
            let valA = a.cells[colIndex].textContent.trim();
            let valB = b.cells[colIndex].textContent.trim();
            
            if (colIndex === 1) {
                return dir === 'asc' ? parseFloat(valA) - parseFloat(valB) : parseFloat(valB) - parseFloat(valA);
            } else {
                return dir === 'asc' ? valA.localeCompare(valB) : valB.localeCompare(valA);
            }
        });
        
        tbody.innerHTML = "";
        rows.forEach(row => tbody.appendChild(row));
    }

    function getCellValue(row, colIndex) {
        const cell = row.cells[colIndex];
        if (colIndex === 1) {
            const mainDiv = cell.querySelector("div");
            return mainDiv ? mainDiv.textContent.trim() : cell.textContent.trim();
        }
        return cell.textContent.trim();
    }

    function parseCustomDate(dateStr) {
        const match = dateStr.match(/(\d{2})\/(\d{2})\/(\d{4})\s+a las\s+(\d{2}):(\d{2})/);
        if (match) {
            return new Date(parseInt(match[3]), parseInt(match[2]) - 1, parseInt(match[1]), parseInt(match[4]), parseInt(match[5]));
        }
        return new Date(0);
    }

    document.addEventListener('DOMContentLoaded', function() {
        if (document.getElementById('product_id_filter')) {
            new TomSelect("#product_id_filter", {
                create: false,
                sortField: { field: "text", direction: "asc" },
                placeholder: "Todos los productos"
            });
        }
        
        // AJAX toggle for labor status
        document.addEventListener('change', function(e) {
            if (e.target && e.target.classList.contains('labor-toggle')) {
                const checkbox = e.target;
                const orderId = checkbox.getAttribute('data-id');
                const isLabor = checkbox.checked;
                const labelSpan = checkbox.nextElementSibling.nextElementSibling;
                
                checkbox.disabled = true;
                
                fetch(`/orders/${orderId}/labor`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ labor: isLabor })
                })
                .then(res => {
                    if (!res.ok) throw new Error('Network error');
                    return res.json();
                })
                .then(data => {
                    checkbox.disabled = false;
                    if (data.success) {
                        labelSpan.textContent = isLabor ? 'Sí' : 'No';
                        if (isLabor) {
                            labelSpan.className = 'ml-2 text-xs text-brand-600 font-semibold';
                        } else {
                            labelSpan.className = 'ml-2 text-xs text-ink-700 font-medium';
                        }
                    } else {
                        checkbox.checked = !isLabor;
                        alert('Error al actualizar el estado.');
                    }
                })
                .catch(err => {
                    checkbox.checked = !isLabor;
                    checkbox.disabled = false;
                    console.error(err);
                    alert('Error al conectar con el servidor.');
                });
            }
        });
    });
</script>
<%- include('partials/footer') %>
