<%- include('../partials/header') %>
<div class="mb-6">
    <a href="/inventory" class="text-sm text-brand-600 hover:underline mb-2 inline-block">&larr; Volver a Catálogo</a>
    <h1 class="text-2xl font-semibold text-ink-900 tracking-tight">Registrar Movimiento de Inventario</h1>
</div>

<div class="panel max-w-md mx-auto bg-panel border border-ink-300 rounded-lg shadow-subtle p-6">
    <div class="mb-5 pb-4 border-b border-ink-300">
        <span class="text-xs text-ink-500 font-mono block mb-1">SUMINISTRO</span>
        <h2 class="text-lg font-bold text-ink-900 leading-tight mb-2"><%= supply.name %></h2>
        <div class="flex items-center justify-between mt-1">
            <span class="text-xs text-ink-500">Stock Actual: <strong class="text-ink-900"><%= supply.quantity %> <%= supply.unit_of_measure %></strong></span>
            
            <% if (type === 'entrada') { %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-900/50">Ingreso (+)</span>
            <% } else { %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 dark:bg-rose-950/40 dark:text-rose-300 border border-rose-200 dark:border-rose-900/50">Egreso (-)</span>
            <% } %>
        </div>
    </div>

    <form action="/inventory/<%= supply.id %>/adjust" method="POST" class="space-y-5">
        <input type="hidden" name="type" value="<%= type %>">
        
        <div>
            <label class="block text-sm font-medium text-ink-900 mb-1.5">Cantidad a registrar</label>
            <div class="relative rounded-md shadow-sm">
                <input type="number" step="0.01" min="0.01" name="amount" required class="input-minimal" placeholder="0.00">
                <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                    <span class="text-xs text-ink-500"><%= supply.unit_of_measure %></span>
                </div>
            </div>
        </div>
        
        <div>
            <label class="block text-sm font-medium text-ink-900 mb-1.5">Concepto / Motivo</label>
            <input type="text" name="concept" required class="input-minimal" placeholder="Ej. Carga de pedido #103, Reabastecimiento de stock">
        </div>
        
        <div class="pt-4 border-t border-ink-300 flex gap-3">
            <a href="/inventory" class="flex-1 btn-outline text-center py-2">Cancelar</a>
            <button type="submit" class="flex-1 btn-minimal py-2">Registrar Ajuste</button>
        </div>
    </form>
</div>
<%- include('../partials/footer') %>
