<%- include('partials/header') %>
<style>
    .sortable-ghost { opacity: 0.3; background-color: #f7fafc; border: 1px dashed #cbd5e1; }
    .sortable-drag { cursor: grabbing !important; }
    .scroll-invisible::-webkit-scrollbar { display: none; }
    .scroll-invisible { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<div class="mb-8 flex justify-between items-center">
    <h1 class="text-2xl font-semibold text-ink-900 tracking-tight">Tablero de Producción</h1>
</div>

<div class="flex flex-col md:flex-row md:overflow-x-auto space-y-5 md:space-y-0 md:space-x-5 pb-8 min-h-[75vh] scroll-invisible">
    <% 
        const columns = [
            { id: 'pendiente', name: 'Pendiente', headerBg: 'bg-status-pending', text: 'text-ink-500' },
            { id: 'imprimiendo', name: 'Imprimiendo', headerBg: 'bg-status-printing', text: 'text-indigo-600' },
            { id: 'cortando', name: 'Cortando', headerBg: 'bg-status-cutting', text: 'text-yellow-600' },
            { id: 'terminado', name: 'Terminado', headerBg: 'bg-status-finished', text: 'text-emerald-600' },
            { id: 'entregado', name: 'Entregado', headerBg: 'bg-status-delivered', text: 'text-pink-600' }
        ];
    %>
    
    <% columns.forEach(col => { %>
        <div class="w-full md:w-80 flex-shrink-0 flex flex-col rounded-xl border border-ink-300 bg-surface">
            <div class="<%= col.headerBg %> px-5 py-4 rounded-t-xl border-b border-ink-300 flex justify-between items-center transition-colors">
                <h3 class="font-medium text-sm <%= col.text %>"><%= col.name %></h3>
                <span class="bg-white/60 backdrop-blur-sm text-ink-500 text-xs font-semibold px-2.5 py-0.5 rounded-full">
                    <%= board[col.id] ? board[col.id].length : 0 %>
                </span>
            </div>
            
            <div class="p-4 flex-1 overflow-y-auto sortable-list" data-status="<%= col.id %>">
                <% (board[col.id] || []).forEach(order => { %>
                    <div class="mb-3 bg-panel p-4 rounded-lg shadow-subtle border border-ink-300 cursor-grab hover:border-brand-300 transition-colors group relative" data-id="<%= order.id %>">
                        <div class="flex justify-between items-start mb-3">
                            <span class="text-[11px] font-mono font-medium text-ink-500">#<%= order.id %></span>
                            <span class="text-xs font-medium text-brand-600 bg-brand-50 px-2 py-1 rounded">
                                <%= order.quantity %> unid.
                            </span>
                        </div>
                        
                        <h4 class="font-medium text-ink-900 text-sm mb-1 leading-snug"><%= order.product_name %></h4>
                        <p class="text-[11px] text-ink-500 mb-3 leading-relaxed">
                            <%= order.height %>x<%= order.width %>cm &bull; <%= order.total_sheets %> Hojas<br>
                            <% if (order.quality_name) { %><span class="font-medium text-ink-700">Calidad:</span> <%= order.quality_name %><% } %>
                        </p>
                        
                        <% if (order.operator_username) { %>
                            <div class="mb-3">
                                <span class="inline-flex items-center gap-1 bg-amber-50 text-amber-700 border border-amber-200 text-[10px] font-semibold px-2 py-0.5 rounded-full">
                                    👤 <%= order.operator_username %>
                                </span>
                            </div>
                        <% } %>
                        
                        <!-- Attachments -->
                        <div class="flex space-x-3 mb-4">
                            <% if (order.image_path) { %><a href="<%= order.image_path %>" target="_blank" class="text-xs text-ink-500 hover:text-brand-600 transition-colors flex items-center gap-1" onclick="event.stopPropagation()">Img</a><% } %>
                            <% if (order.pdf_path) { %><a href="<%= order.pdf_path %>" target="_blank" class="text-xs text-ink-500 hover:text-brand-600 transition-colors flex items-center gap-1" onclick="event.stopPropagation()">PDF</a><% } %>
                            <% if (order.word_path) { %><a href="<%= order.word_path %>" target="_blank" class="text-xs text-ink-500 hover:text-brand-600 transition-colors flex items-center gap-1" onclick="event.stopPropagation()">Doc</a><% } %>
                        </div>
                                                <% if (order.observations) { %>
                            <div class="mt-3 pt-3 border-t border-ink-300">
                                <p class="text-xs text-ink-500 italic line-clamp-2" title="<%= order.observations %>"><%= order.observations %></p>
                            </div>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        </div>
    <% }) %>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const lists = document.querySelectorAll('.sortable-list');
        lists.forEach(list => {
            new Sortable(list, {
                group: 'kanban',
                animation: 150,
                ghostClass: 'sortable-ghost',
                dragClass: 'sortable-drag',
                onEnd: function (evt) {
                    const itemEl = evt.item;
                    const orderId = itemEl.getAttribute('data-id');
                    const toList = evt.to;
                    const newStatus = toList.getAttribute('data-status');
                    const oldStatus = evt.from.getAttribute('data-status');
                    
                    if(newStatus !== oldStatus) {
                        fetch(`/api/orders/${orderId}/status`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ status: newStatus })
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (!data.success) {
                                alert('Error al mover: ' + (data.error || 'Desconocido'));
                                evt.from.appendChild(itemEl);
                            } else {
                                window.location.reload();
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            alert('Error de red');
                            evt.from.appendChild(itemEl);
                        });
                    }
                },
            });
        });
    });
</script>
<%- include('partials/footer') %>
