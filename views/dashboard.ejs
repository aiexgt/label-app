<%- include('partials/header') %>
<style>
    .sortable-ghost { opacity: 0.3; background-color: var(--color-brand-50); border: 1px dashed var(--color-ink-300); }
    .sortable-drag { cursor: grabbing !important; }
    .scroll-invisible::-webkit-scrollbar { display: none; }
    .scroll-invisible { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<div class="mb-4 flex flex-col sm:flex-row justify-between sm:items-center gap-3 flex-shrink-0">
    <h1 class="text-2xl font-semibold text-ink-900 tracking-tight">Tablero de Producción</h1>
    <% if (user.is_admin) { %>
        <div class="flex items-center gap-2">
            <label class="text-xs font-semibold text-ink-500 uppercase tracking-wider">Sucursal:</label>
            <form action="/dashboard" method="GET" id="branch-filter-form">
                <select name="branch_id" onchange="document.getElementById('branch-filter-form').submit()" class="text-sm rounded border-ink-300 bg-panel text-ink-900 py-1.5 px-3 focus:ring-0 focus:border-brand-500 transition-colors font-medium cursor-pointer">
                    <option value="global" <%= selectedBranchId === 'global' ? 'selected' : '' %>>Todas / Global</option>
                    <% branches.forEach(b => { %>
                        <option value="<%= b.id %>" <%= String(selectedBranchId) === String(b.id) ? 'selected' : '' %>><%= b.name %></option>
                    <% }) %>
                </select>
            </form>
        </div>
    <% } %>
</div>

<div class="flex-1 flex flex-row overflow-x-auto space-x-4 pb-4 scroll-invisible overflow-y-hidden">
    <% 
        const columns = [
            { id: 'backlog', name: 'Backlog', headerBg: 'bg-slate-100 dark:bg-zinc-800', text: 'text-slate-600 dark:text-zinc-400' },
            { id: 'pendiente', name: 'Pendiente', headerBg: 'bg-status-pending', text: 'text-status-pending-text' },
            { id: 'imprimiendo', name: 'Imprimiendo', headerBg: 'bg-status-printing', text: 'text-status-printing-text' },
            { id: 'impreso', name: 'Impreso', headerBg: 'bg-status-printed', text: 'text-status-printed-text' },
            { id: 'cortando', name: 'Cortando', headerBg: 'bg-status-cutting', text: 'text-status-cutting-text' },
            { id: 'terminado', name: 'Terminado', headerBg: 'bg-status-finished', text: 'text-status-finished-text' },
            { id: 'por_entregar', name: 'Por Entregar', headerBg: 'bg-blue-100 dark:bg-blue-950/40', text: 'text-blue-600 dark:text-blue-400' },
            { id: 'entregado', name: user.is_admin ? 'Entregado (Semana)' : 'Entregado (Hoy)', headerBg: 'bg-status-delivered', text: 'text-status-delivered-text' }
        ];
    %>
    
    <% columns.forEach(col => { %>
        <div class="w-[280px] sm:w-80 flex-shrink-0 flex flex-col rounded-xl border border-ink-300 bg-surface h-full overflow-hidden">
            <div class="<%= col.headerBg %> px-5 py-4 rounded-t-xl border-b border-ink-300 flex justify-between items-center transition-colors flex-shrink-0">
                <h3 class="font-medium text-sm <%= col.text %>"><%= col.name %></h3>
                <span id="count-<%= col.id %>" class="bg-panel/60 backdrop-blur-sm text-ink-500 text-xs font-semibold px-2.5 py-0.5 rounded-full">
                    <%= board[col.id] ? board[col.id].length : 0 %>
                </span>
            </div>
            
            <div class="p-4 flex-1 overflow-y-auto sortable-list" data-status="<%= col.id %>">
                <% (board[col.id] || []).forEach(order => { %>
                    <div class="mb-3 bg-panel p-4 rounded-lg shadow-subtle border border-ink-300 <%= user.is_customer ? '' : 'cursor-grab hover:border-brand-300' %> transition-colors group relative" data-id="<%= order.id %>">
                        <div class="flex justify-between items-start mb-3">
                            <span class="text-[11px] font-mono font-medium text-ink-500">#<%= order.id %></span>
                            <div class="flex items-center gap-1.5">
                                <% if (!user.is_customer) { %>
                                    <button onclick="splitOrder(<%= order.id %>, <%= order.quantity %>)" 
                                            class="text-[10px] bg-zinc-100 hover:bg-zinc-200 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-700 px-1.5 py-0.5 rounded border border-ink-300 font-semibold cursor-pointer transition-colors"
                                            title="Dividir pedido">
                                        ✂️ Dividir
                                    </button>
                                <% } %>
                                <% if (user.is_customer) { %>
                                    <span class="text-xs font-medium text-ink-500 bg-brand-50 px-2 py-1 rounded" id="qty-text-<%= order.id %>">
                                        <%= order.quantity %> unid.
                                    </span>
                                <% } else { %>
                                    <span class="text-xs font-medium text-brand-600 bg-brand-50 px-2 py-1 rounded cursor-pointer hover:bg-brand-200 transition-colors" id="qty-text-<%= order.id %>" onclick="editQuantity(<%= order.id %>, <%= order.quantity %>)" title="Editar cantidad">
                                        <%= order.quantity %> unid. ✏️
                                    </span>
                                <% } %>
                            </div>
                        </div>
                        
                        <% if (user.is_admin || user.is_manager) { %>
                            <div class="absolute top-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                <form action="/orders/<%= order.id %>/delete" method="POST" class="ajax-delete-form" onsubmit="return confirm('¿Seguro que deseas ELIMINAR este pedido por completo?');">
                                    <button type="submit" class="text-red-500 hover:text-red-700 bg-panel rounded-full p-1 shadow-sm border border-red-200 dark:border-red-900/50" title="Eliminar pedido">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        <% } %>
                        
                        <h4 class="font-medium text-ink-900 text-sm mb-1 leading-snug"><%= order.product_name %></h4>
                        <p class="text-[11px] text-ink-500 mb-3 leading-relaxed">
                            <%= order.height %>x<%= order.width %>cm &bull; <span id="sheets-text-<%= order.id %>"><%= order.total_sheets %></span> Hojas<br>
                            <% if (order.quality_name) { %><span class="font-medium text-ink-700">Calidad:</span> <%= order.quality_name %><br><% } %>
                            <span class="font-medium text-ink-700">Papel:</span> <%= order.paper_type || 'Matte' %>
                        </p>
                        
                        <% if (order.tags) { %>
                            <div class="flex flex-wrap gap-1 mb-3">
                                <% order.tags.split(',').forEach(tag => { %>
                                    <% if(tag.trim() !== '') { %>
                                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-brand-50 text-brand-700 uppercase tracking-wider border border-brand-200"><%= tag.trim() %></span>
                                    <% } %>
                                <% }) %>
                            </div>
                        <% } %>
                        
                        <div class="flex flex-wrap gap-2 mb-3">
                            <% if (order.operator_username) { %>
                                <span id="operator-<%= order.id %>" class="inline-flex items-center gap-1 bg-amber-50 text-amber-700 border border-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:border-amber-900/50 text-[10px] font-semibold px-2 py-0.5 rounded-full">
                                    👤 <%= order.operator_username %>
                                </span>
                            <% } %>
                            
                            <% if (user.is_customer) { %>
                                <span class="inline-flex items-center gap-1 text-[10px] font-semibold px-2 py-0.5 rounded-full border <%= order.labor ? 'bg-amber-100 text-amber-800 border-amber-300 dark:bg-amber-950/40 dark:text-amber-300 dark:border-amber-900/50' : 'bg-ink-100 text-ink-500 border-ink-300 dark:bg-zinc-800 dark:text-ink-400 dark:border-zinc-700' %>">
                                    🛠️ <%= order.labor ? 'Mano de Obra' : 'Sin Mano de Obra' %>
                                </span>
                            <% } else { %>
                                <span id="labor-pill-<%= order.id %>" 
                                      onclick="toggleLabor(<%= order.id %>)" 
                                      class="inline-flex items-center gap-1 text-[10px] font-semibold px-2 py-0.5 rounded-full border cursor-pointer hover:opacity-85 transition-opacity <%= order.labor ? 'bg-amber-100 text-amber-800 border-amber-300 dark:bg-amber-950/40 dark:text-amber-300 dark:border-amber-900/50' : 'bg-ink-100 text-ink-500 border-ink-300 dark:bg-zinc-800 dark:text-ink-400 dark:border-zinc-700' %>"
                                      data-labor="<%= order.labor %>"
                                      title="Click para cambiar estado de Mano de Obra">
                                    🛠️ <%= order.labor ? 'Mano de Obra' : 'Sin Mano de Obra' %>
                                </span>
                            <% } %>
                        </div>
                        
                        <!-- Attachments -->
                        <div class="flex flex-wrap gap-x-3 gap-y-1 mb-4">
                            <% if (order.image_path) { %><a href="<%= order.image_path %>" target="_blank" class="text-xs text-ink-500 hover:text-brand-600 transition-colors flex items-center gap-1" onclick="event.stopPropagation()">Diseño</a><% } %>
                            <% if (order.word_path) { %><a href="<%= order.word_path %>" target="_blank" class="text-xs text-ink-500 hover:text-brand-600 transition-colors flex items-center gap-1" onclick="event.stopPropagation()">DOC</a><% } %>
                            <% if (order.pdf_path) { %><a href="<%= order.pdf_path %>" target="_blank" class="text-xs text-ink-500 hover:text-brand-600 transition-colors flex items-center gap-1" onclick="event.stopPropagation()">PDF Grupo</a><% } %>
                            <% if (order.pdf_individual_path) { %><a href="<%= order.pdf_individual_path %>" target="_blank" class="text-xs text-ink-500 hover:text-brand-600 transition-colors flex items-center gap-1" onclick="event.stopPropagation()">PDF Individual</a><% } %>
                        </div>
                        <div class="mt-3 pt-3 border-t border-ink-300 relative group/obs">
                            <p class="text-[11px] text-ink-500 italic whitespace-pre-wrap" id="obs-text-<%= order.id %>"><%= order.observations || 'Sin observaciones...' %></p>
                            <% if (!user.is_customer) { %>
                                <button onclick="editObservations(<%= order.id %>)" class="absolute top-1 right-0 opacity-0 group-hover/obs:opacity-100 text-brand-600 hover:text-brand-700 bg-panel px-1.5 py-0.5 rounded text-[10px] shadow-sm border border-ink-300 transition-opacity">✏️ Editar</button>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    <% }) %>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const lists = document.querySelectorAll('.sortable-list');
        lists.forEach(list => {
            new Sortable(list, {
                group: 'kanban',
                animation: 150,
                ghostClass: 'sortable-ghost',
                dragClass: 'sortable-drag',
                disabled: <%= user.is_customer ? 'true' : 'false' %>,
                onEnd: function (evt) {
                    const itemEl = evt.item;
                    const orderId = itemEl.getAttribute('data-id');
                    const toList = evt.to;
                    const newStatus = toList.getAttribute('data-status');
                    const oldStatus = evt.from.getAttribute('data-status');
                    
                    const updateColumnOrder = (listEl) => {
                        const ids = Array.from(listEl.children)
                            .map(el => el.getAttribute('data-id'))
                            .filter(id => id !== null);
                        return fetch('/api/orders/reorder', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ ids })
                        })
                        .then(res => res.json())
                        .then(data => {
                            if (!data.success) {
                                console.error('Failed to update column order:', data.error);
                            }
                        })
                        .catch(err => console.error('Error updating column order:', err));
                    };

                    if(newStatus !== oldStatus) {
                        fetch(`/api/orders/${orderId}/status`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ status: newStatus })
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (!data.success) {
                                alert('Error al mover: ' + (data.error || 'Desconocido'));
                                evt.from.appendChild(itemEl);
                            } else {
                                const fromCountEl = document.getElementById('count-' + oldStatus);
                                const toCountEl = document.getElementById('count-' + newStatus);
                                if (fromCountEl) fromCountEl.textContent = Math.max(0, parseInt(fromCountEl.textContent) - 1);
                                if (toCountEl) toCountEl.textContent = parseInt(toCountEl.textContent) + 1;
                                
                                const opPill = document.getElementById('operator-' + orderId);
                                if (opPill && data.operator_username) {
                                    opPill.textContent = '👤 ' + data.operator_username;
                                }
                                
                                // Update positions in both columns
                                updateColumnOrder(toList);
                                updateColumnOrder(evt.from);
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            alert('Error de red');
                            evt.from.appendChild(itemEl);
                        });
                    } else {
                        // Same column reordering
                        updateColumnOrder(toList);
                    }
                },
            });
        });
    });

    function toggleLabor(id) {
        const pill = document.getElementById('labor-pill-' + id);
        const currentLabor = pill.getAttribute('data-labor') === 'true';
        const newLabor = !currentLabor;
        
        pill.style.pointerEvents = 'none';
        pill.style.opacity = '0.5';
        
        fetch(`/orders/${id}/labor`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ labor: newLabor })
        })
        .then(res => res.json())
        .then(data => {
            pill.style.pointerEvents = 'auto';
            pill.style.opacity = '1';
            
            if (data.success) {
                pill.setAttribute('data-labor', newLabor ? 'true' : 'false');
                pill.textContent = newLabor ? '🛠️ Mano de Obra' : '🛠️ Sin Mano de Obra';
                
                if (newLabor) {
                    pill.className = "inline-flex items-center gap-1 text-[10px] font-semibold px-2 py-0.5 rounded-full border cursor-pointer hover:opacity-85 transition-opacity bg-amber-100 text-amber-800 border-amber-300 dark:bg-amber-950/40 dark:text-amber-300 dark:border-amber-900/50";
                } else {
                    pill.className = "inline-flex items-center gap-1 text-[10px] font-semibold px-2 py-0.5 rounded-full border cursor-pointer hover:opacity-85 transition-opacity bg-ink-100 text-ink-500 border-ink-300 dark:bg-zinc-800 dark:text-ink-400 dark:border-zinc-700";
                }
            } else {
                alert('Error al guardar: ' + (data.error || 'Desconocido'));
            }
        })
        .catch(err => {
            pill.style.pointerEvents = 'auto';
            pill.style.opacity = '1';
            console.error(err);
            alert('Error de red al guardar.');
        });
    }

    function editObservations(id) {
        const textEl = document.getElementById('obs-text-' + id);
        const currentText = textEl.textContent === 'Sin observaciones...' ? '' : textEl.textContent;
        const newText = prompt('Comentario / Observación para el pedido #' + id + ':', currentText);
        
        if (newText !== null) {
            fetch(`/api/orders/${id}/observations`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ observations: newText.trim() })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    textEl.textContent = newText.trim() || 'Sin observaciones...';
                } else {
                    alert('Error al guardar: ' + (data.error || 'Desconocido'));
                }
            })
            .catch(err => {
                console.error(err);
                alert('Error de red al guardar.');
            });
        }
    }

    function editQuantity(id, currentQty) {
        const newQtyStr = prompt('Ingresa la nueva cantidad para el pedido #' + id + ':', currentQty);
        if (newQtyStr !== null) {
            const newQty = parseInt(newQtyStr, 10);
            if (!isNaN(newQty) && newQty > 0) {
                fetch(`/api/orders/${id}/quantity`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ quantity: newQty })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        const qtyEl = document.getElementById('qty-text-' + id);
                        if (qtyEl) {
                            qtyEl.innerHTML = data.new_quantity + ' unid. ✏️';
                            qtyEl.setAttribute('onclick', `editQuantity(${id}, ${data.new_quantity})`);
                        }
                        const sheetsEl = document.getElementById('sheets-text-' + id);
                        if (sheetsEl && data.total_sheets) {
                            sheetsEl.textContent = data.total_sheets;
                        }
                    } else {
                        alert('Error: ' + (data.error || 'Desconocido'));
                    }
                })
                .catch(err => {
                    console.error(err);
                    alert('Error de red al actualizar cantidad.');
                });
            } else {
                alert('Por favor ingresa una cantidad válida mayor a 0.');
            }
        }
    }

    function splitOrder(id, currentQty) {
        const splitQtyStr = prompt('¿Cuántas unidades deseas separar para el nuevo pedido? (Debe ser menor a ' + currentQty + '):');
        if (splitQtyStr !== null) {
            const splitQty = parseInt(splitQtyStr, 10);
            if (!isNaN(splitQty) && splitQty > 0) {
                if (splitQty >= currentQty) {
                    alert('La cantidad a dividir debe ser menor que la cantidad actual del pedido (' + currentQty + ').');
                    return;
                }
                
                fetch(`/orders/${id}/split`, {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ splitQuantity: splitQty })
                })
                .then(async res => {
                    if (!res.ok) {
                        const text = await res.text();
                        throw new Error(text);
                    }
                    return res.json();
                })
                .then(data => {
                    if (data.success) {
                        window.location.reload();
                    } else {
                        alert('Error: ' + (data.error || 'Desconocido'));
                    }
                })
                .catch(err => {
                    console.error(err);
                    alert(err.message || 'Error de red al intentar dividir el pedido.');
                });
            } else {
                alert('Por favor ingresa una cantidad válida mayor a 0.');
            }
        }
    }
</script>
<%- include('partials/footer') %>
