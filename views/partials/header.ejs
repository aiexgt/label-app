<!DOCTYPE html>
<html lang="es" class="h-full bg-[#fcfcfc]">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Label Orders Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: { 
                        surface: '#fcfcfc',
                        panel: '#ffffff',
                        ink: { 900: '#1a1a1a', 500: '#666666', 300: '#e5e5e5' },
                        brand: { 500: '#2d3748', 600: '#1a202c', 50: '#f7fafc' },
                        status: {
                            pending: '#f3f4f6', 
                            printing: '#e0e7ff', 
                            cutting: '#fef3c7', 
                            finished: '#d1fae5',
                            delivered: '#fce7f3',
                            paid: '#ccfbf1'
                        }
                    },
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    boxShadow: { 'subtle': '0 1px 2px 0 rgba(0, 0, 0, 0.05)' }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style type="text/tailwindcss">
        body { font-family: 'Inter', sans-serif; color: #1a1a1a; }
        .input-minimal { @apply w-full rounded-md border-gray-200 bg-gray-50 focus:bg-white focus:ring-0 focus:border-brand-500 text-sm px-4 py-2 transition-colors; }
        .btn-minimal { @apply inline-flex items-center justify-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-brand-500 hover:bg-brand-600 focus:outline-none transition-colors; }
        .btn-outline { @apply inline-flex items-center justify-center px-4 py-2 border border-gray-200 rounded-md shadow-sm text-sm font-medium text-ink-900 bg-white hover:bg-gray-50 focus:outline-none transition-colors; }
        .panel { @apply bg-panel border border-ink-300 rounded-lg shadow-subtle p-6; }
    </style>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.2/Sortable.min.js"></script>
</head>
<body class="h-full flex flex-col bg-surface">
    <% if (user) { %>
    <nav x-data="{ mobileMenuOpen: false }" class="bg-panel border-b border-ink-300 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-14">
                <div class="flex items-center">
                    <a href="/dashboard" class="flex-shrink-0 font-semibold text-lg tracking-tight text-ink-900">
                        LabelPro
                    </a>
                    <div class="hidden md:block">
                        <div class="ml-10 flex items-baseline space-x-6">
                            <a href="/dashboard" class="text-ink-500 hover:text-ink-900 text-sm font-medium transition-colors">Tablero</a>
                            <a href="/orders/new" class="text-ink-500 hover:text-ink-900 text-sm font-medium transition-colors">Nuevo Pedido</a>
                            <% if (user.is_admin) { %>
                                <a href="/admin/labels" class="text-ink-500 hover:text-ink-900 text-sm font-medium transition-colors">Etiquetas</a>
                                <a href="/admin/products" class="text-ink-500 hover:text-ink-900 text-sm font-medium transition-colors">Catálogo</a>
                                <a href="/admin/printers" class="text-ink-500 hover:text-ink-900 text-sm font-medium transition-colors">Impresoras</a>
                                <a href="/admin/finances" class="text-ink-500 hover:text-ink-900 text-sm font-medium transition-colors">Finanzas</a>
                                <a href="/admin/users" class="text-ink-500 hover:text-ink-900 text-sm font-medium transition-colors">Usuarios</a>
                            <% } %>
                        </div>
                    </div>
                </div>
                <div class="hidden md:block">
                    <div class="flex items-center space-x-4">
                        <span class="text-xs font-medium text-ink-500"><%= user.username %> <%= user.is_admin ? '(Admin)' : '' %></span>
                        <a href="/auth/logout" class="text-xs text-ink-500 hover:text-ink-900 transition-colors">Salir</a>
                    </div>
                </div>
                <div class="-mr-2 flex md:hidden">
                    <!-- Mobile menu button -->
                    <button type="button" @click="mobileMenuOpen = !mobileMenuOpen" class="inline-flex items-center justify-center p-2 rounded-md text-ink-500 hover:text-ink-900 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-brand-500" aria-expanded="false">
                        <span class="sr-only">Abrir menú principal</span>
                        <svg x-show="!mobileMenuOpen" class="block h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                        <svg x-show="mobileMenuOpen" style="display: none;" class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile menu, show/hide based on menu state. -->
        <div x-show="mobileMenuOpen" style="display: none;" class="md:hidden border-t border-ink-300 bg-panel max-h-[calc(100vh-3.5rem)] overflow-y-auto shadow-xl">
            <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
                <a href="/dashboard" class="text-ink-900 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium">Tablero</a>
                <a href="/orders/new" class="text-ink-900 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium">Nuevo Pedido</a>
                <% if (user.is_admin) { %>
                    <a href="/admin/labels" class="text-ink-900 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium">Etiquetas</a>
                    <a href="/admin/products" class="text-ink-900 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium">Catálogo</a>
                    <a href="/admin/printers" class="text-ink-900 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium">Impresoras</a>
                    <a href="/admin/finances" class="text-ink-900 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium">Finanzas</a>
                    <a href="/admin/users" class="text-ink-900 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium">Usuarios</a>
                <% } %>
            </div>
            <div class="pt-4 pb-3 border-t border-ink-300">
                <div class="flex items-center px-5">
                    <div class="ml-3">
                        <div class="text-base font-medium text-ink-900"><%= user.username %></div>
                        <div class="text-sm font-medium text-ink-500"><%= user.is_admin ? 'Administrador' : 'Operador' %></div>
                    </div>
                </div>
                <div class="mt-3 px-2 space-y-1">
                    <a href="/auth/logout" class="block px-3 py-2 rounded-md text-base font-medium text-red-600 hover:bg-gray-50">Cerrar Sesión</a>
                </div>
            </div>
        </div>
    </nav>
    <% } %>
    <main class="flex-grow w-full max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
