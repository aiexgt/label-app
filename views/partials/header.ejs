<!DOCTYPE html>
<html lang="es" class="h-full <%= typeof isFluid !== 'undefined' && isFluid ? 'overflow-hidden' : '' %> bg-surface transition-colors duration-200">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Etiquetas Alex</title>
    
    <script>
        // Check local storage or system preference to apply dark mode early
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: { 
                        surface: 'var(--color-surface)',
                        panel: 'var(--color-panel)',
                        ink: { 
                            900: 'var(--color-ink-900)', 
                            700: 'var(--color-ink-700)', 
                            500: 'var(--color-ink-500)', 
                            300: 'var(--color-ink-300)' 
                        },
                        brand: { 
                            50: 'var(--color-brand-50)', 
                            200: 'var(--color-brand-200)', 
                            500: 'var(--color-brand-500)', 
                            600: 'var(--color-brand-600)',
                            700: 'var(--color-brand-700)'
                        },
                        status: {
                            pending: 'var(--color-status-pending)', 
                            printing: 'var(--color-status-printing)', 
                            printed: 'var(--color-status-printed)', 
                            cutting: 'var(--color-status-cutting)', 
                            finished: 'var(--color-status-finished)',
                            delivered: 'var(--color-status-delivered)',
                            'pending-text': 'var(--color-text-pending)',
                            'printing-text': 'var(--color-text-printing)',
                            'printed-text': 'var(--color-text-printed)',
                            'cutting-text': 'var(--color-text-cutting)',
                            'finished-text': 'var(--color-text-finished)',
                            'delivered-text': 'var(--color-text-delivered)'
                        }
                    },
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    boxShadow: { 'subtle': '0 1px 2px 0 rgba(0, 0, 0, 0.05)' }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style type="text/tailwindcss">
        :root {
            --color-surface: #fcfcfc;
            --color-panel: #ffffff;
            --color-ink-900: #1a1a1a;
            --color-ink-700: #404040;
            --color-ink-500: #737373;
            --color-ink-300: #e5e5e5;
            --color-brand-50: #f5f5f5;
            --color-brand-200: #e5e5e5;
            --color-brand-500: #262626;
            --color-brand-600: #171717;
            --color-brand-700: #0a0a0a;

            --color-status-pending: #f3f4f6;
            --color-status-printing: #e0e7ff;
            --color-status-printed: #cffafe;
            --color-status-cutting: #fef3c7;
            --color-status-finished: #d1fae5;
            --color-status-delivered: #fce7f3;

            --color-text-pending: #4b5563;
            --color-text-printing: #4f46e5;
            --color-text-printed: #0891b2;
            --color-text-cutting: #d97706;
            --color-text-finished: #059669;
            --color-text-delivered: #db2777;
        }

        .dark {
            --color-surface: #0a0a0a;
            --color-panel: #171717;
            --color-ink-900: #f5f5f5;
            --color-ink-700: #d4d4d4;
            --color-ink-500: #a3a3a3;
            --color-ink-300: #262626;
            --color-brand-50: #262626;
            --color-brand-200: #404040;
            --color-brand-500: #e5e5e5;
            --color-brand-600: #f5f5f5;
            --color-brand-700: #ffffff;

            --color-status-pending: #262626;
            --color-status-printing: #1e1b4b;
            --color-status-printed: #083344;
            --color-status-cutting: #451a03;
            --color-status-finished: #064e3b;
            --color-status-delivered: #4c0519;

            --color-text-pending: #a3a3a3;
            --color-text-printing: #818cf8;
            --color-text-printed: #22d3ee;
            --color-text-cutting: #fbbf24;
            --color-text-finished: #34d399;
            --color-text-delivered: #f472b6;
        }

        body { font-family: 'Inter', sans-serif; color: var(--color-ink-900); }
        .input-minimal { @apply w-full rounded-md border-ink-300 bg-brand-50 focus:bg-panel focus:ring-0 focus:border-brand-500 text-sm px-4 py-2 transition-colors text-ink-900 placeholder:text-ink-500; }
        .btn-minimal { @apply inline-flex items-center justify-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-surface bg-ink-900 dark:bg-brand-500 hover:opacity-90 focus:outline-none transition-colors; }
        .btn-outline { @apply inline-flex items-center justify-center px-4 py-2 border border-ink-300 rounded-md shadow-sm text-sm font-medium text-ink-900 bg-panel hover:bg-brand-50 focus:outline-none transition-colors; }
        .panel { @apply bg-panel border border-ink-300 rounded-lg shadow-subtle p-6; }

        /* TomSelect overrides for Dark Mode */
        .ts-wrapper {
            color: var(--color-ink-900);
        }
        .ts-control {
            background-color: var(--color-brand-50) !important;
            border-color: var(--color-ink-300) !important;
            color: var(--color-ink-900) !important;
            border-radius: 0.375rem !important;
            padding: 0.5rem 2.5rem 0.5rem 1rem !important;
            box-shadow: none !important;
            transition: border-color 0.15s ease, background-color 0.15s ease;
        }
        .ts-control input {
            color: var(--color-ink-900) !important;
        }
        .ts-dropdown {
            background-color: var(--color-panel) !important;
            border-color: var(--color-ink-300) !important;
            color: var(--color-ink-900) !important;
        }
        .ts-dropdown .active {
            background-color: var(--color-brand-50) !important;
            color: var(--color-ink-900) !important;
        }
        .ts-dropdown .option:hover {
            background-color: var(--color-brand-50) !important;
        }
        .ts-dropdown .create:hover {
            background-color: var(--color-brand-50) !important;
        }
        .ts-wrapper.single .ts-control {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20' fill='none'%3e%3cpath d='M7 9l3 3 3-3' stroke='%23737373' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3e%3c/svg%3e") !important;
            background-size: 1.25rem !important;
            background-repeat: no-repeat !important;
            background-position: right 0.75rem center !important;
        }
        .dark .ts-wrapper.single .ts-control {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20' fill='none'%3e%3cpath d='M7 9l3 3 3-3' stroke='%23a3a3a3' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3e%3c/svg%3e") !important;
            background-size: 1.25rem !important;
            background-repeat: no-repeat !important;
            background-position: right 0.75rem center !important;
        }
    </style>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.2/Sortable.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
</head>
<body class="h-full flex flex-col <%= typeof isFluid !== 'undefined' && isFluid ? 'overflow-hidden' : '' %> bg-surface transition-colors duration-200">
    <% if (user) { %>
    <nav x-data="{ mobileMenuOpen: false }" class="bg-panel border-b border-ink-300 sticky top-0 z-50">
        <div class="px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-14">
                <div class="flex items-center">
                    <a href="/dashboard" class="flex-shrink-0 font-semibold text-lg tracking-tight text-ink-900">
                        Etiquetas Alex
                    </a>
                    <div class="hidden md:block">
                        <div class="ml-10 flex items-baseline space-x-6">
                            <a href="/dashboard" class="text-ink-500 hover:text-ink-900 text-sm font-medium transition-colors">Tablero</a>
                            <% if (!user.is_customer) { %>
                                <a href="/orders/new" class="text-ink-500 hover:text-ink-900 text-sm font-medium transition-colors">Nuevo Pedido</a>
                                <a href="/inventory" class="text-ink-500 hover:text-ink-900 text-sm font-medium transition-colors">Inventario</a>
                                <a href="/inventory/history" class="text-ink-500 hover:text-ink-900 text-sm font-medium transition-colors">Historial Inventario</a>
                            <% } %>
                            <% if (user.is_customer) { %>
                                <a href="/history" class="text-ink-500 hover:text-ink-900 text-sm font-medium transition-colors">Historial Entregados</a>
                            <% } %>
                            <% if (user.is_admin) { %>
                                <a href="/admin/labels" class="text-ink-500 hover:text-ink-900 text-sm font-medium transition-colors">Etiquetas</a>
                                <a href="/admin/products" class="text-ink-500 hover:text-ink-900 text-sm font-medium transition-colors">Catálogo</a>
                                <a href="/admin/users" class="text-ink-500 hover:text-ink-900 text-sm font-medium transition-colors">Usuarios</a>
                            <% } %>
                        </div>
                    </div>
                </div>
                <div class="hidden md:block">
                    <div class="flex items-center space-x-4">
                        <span class="text-xs font-medium text-ink-500"><%= user.username %> <%= user.is_admin ? '(Admin)' : (user.is_customer ? '(Cliente)' : '') %></span>
                        <!-- Theme Toggle Button -->
                        <button id="theme-toggle" type="button" class="text-ink-500 hover:text-ink-900 transition-colors p-1.5 rounded-full hover:bg-brand-50" title="Alternar tema">
                            <svg id="theme-toggle-light-icon" class="hidden w-4 h-4" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 100 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
                            <svg id="theme-toggle-dark-icon" class="hidden w-4 h-4" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
                        </button>
                        <a href="/auth/logout" class="text-xs text-ink-500 hover:text-ink-900 transition-colors">Salir</a>
                    </div>
                </div>
                <div class="-mr-2 flex md:hidden items-center gap-2">
                    <!-- Theme Toggle Button Mobile -->
                    <button id="theme-toggle-mobile" type="button" class="text-ink-500 hover:text-ink-900 transition-colors p-1.5 rounded-full hover:bg-brand-50" title="Alternar tema">
                        <svg id="theme-toggle-light-icon-mobile" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 100 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
                        <svg id="theme-toggle-dark-icon-mobile" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
                    </button>
                    <!-- Mobile menu button -->
                    <button type="button" @click="mobileMenuOpen = !mobileMenuOpen" class="inline-flex items-center justify-center p-2 rounded-md text-ink-500 hover:text-ink-900 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-brand-500" aria-expanded="false">
                        <span class="sr-only">Abrir menú principal</span>
                        <svg x-show="!mobileMenuOpen" class="block h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                        <svg x-show="mobileMenuOpen" style="display: none;" class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile menu, show/hide based on menu state. -->
        <div x-show="mobileMenuOpen" style="display: none;" class="md:hidden border-t border-ink-300 bg-panel max-h-[calc(100vh-3.5rem)] overflow-y-auto shadow-xl">
            <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
                <a href="/dashboard" class="text-ink-900 hover:bg-gray-50 dark:hover:bg-brand-50 block px-3 py-2 rounded-md text-base font-medium">Tablero</a>
                <% if (!user.is_customer) { %>
                    <a href="/orders/new" class="text-ink-900 hover:bg-gray-50 dark:hover:bg-brand-50 block px-3 py-2 rounded-md text-base font-medium">Nuevo Pedido</a>
                    <a href="/inventory" class="text-ink-900 hover:bg-gray-50 dark:hover:bg-brand-50 block px-3 py-2 rounded-md text-base font-medium">Inventario</a>
                    <a href="/inventory/history" class="text-ink-900 hover:bg-gray-50 dark:hover:bg-brand-50 block px-3 py-2 rounded-md text-base font-medium">Historial Inventario</a>
                <% } %>
                <% if (user.is_customer) { %>
                    <a href="/history" class="text-ink-900 hover:bg-gray-50 dark:hover:bg-brand-50 block px-3 py-2 rounded-md text-base font-medium">Historial Entregados</a>
                <% } %>
                <% if (user.is_admin) { %>
                    <a href="/admin/labels" class="text-ink-900 hover:bg-gray-50 dark:hover:bg-brand-50 block px-3 py-2 rounded-md text-base font-medium">Etiquetas</a>
                    <a href="/admin/products" class="text-ink-900 hover:bg-gray-50 dark:hover:bg-brand-50 block px-3 py-2 rounded-md text-base font-medium">Catálogo</a>
                    <a href="/admin/users" class="text-ink-900 hover:bg-gray-50 dark:hover:bg-brand-50 block px-3 py-2 rounded-md text-base font-medium">Usuarios</a>
                <% } %>
            </div>
            <div class="pt-4 pb-3 border-t border-ink-300">
                <div class="flex items-center px-5">
                    <div class="ml-3">
                        <div class="text-base font-medium text-ink-900"><%= user.username %></div>
                        <div class="text-sm font-medium text-ink-500"><%= user.is_admin ? 'Administrador' : (user.is_customer ? 'Cliente' : 'Operador') %></div>
                    </div>
                </div>
                <div class="mt-3 px-2 space-y-1">
                    <a href="/auth/logout" class="block px-3 py-2 rounded-md text-base font-medium text-red-600 hover:bg-gray-50">Cerrar Sesión</a>
                </div>
            </div>
        </div>
    </nav>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const toggleBtn = document.getElementById('theme-toggle');
            const toggleBtnMobile = document.getElementById('theme-toggle-mobile');
            
            const lightIcon = document.getElementById('theme-toggle-light-icon');
            const darkIcon = document.getElementById('theme-toggle-dark-icon');
            const lightIconMobile = document.getElementById('theme-toggle-light-icon-mobile');
            const darkIconMobile = document.getElementById('theme-toggle-dark-icon-mobile');
            
            function updateIcons() {
                const isDark = document.documentElement.classList.contains('dark');
                if (isDark) {
                    if(lightIcon) lightIcon.classList.remove('hidden');
                    if(darkIcon) darkIcon.classList.add('hidden');
                    if(lightIconMobile) lightIconMobile.classList.remove('hidden');
                    if(darkIconMobile) darkIconMobile.classList.add('hidden');
                } else {
                    if(lightIcon) lightIcon.classList.add('hidden');
                    if(darkIcon) darkIcon.classList.remove('hidden');
                    if(lightIconMobile) lightIconMobile.classList.add('hidden');
                    if(darkIconMobile) darkIconMobile.classList.remove('hidden');
                }
            }
            
            function toggleTheme() {
                if (document.documentElement.classList.contains('dark')) {
                    document.documentElement.classList.remove('dark');
                    localStorage.setItem('theme', 'light');
                } else {
                    document.documentElement.classList.add('dark');
                    localStorage.setItem('theme', 'dark');
                }
                updateIcons();
            }
            
            if (toggleBtn) toggleBtn.addEventListener('click', toggleTheme);
            if (toggleBtnMobile) toggleBtnMobile.addEventListener('click', toggleTheme);
            
            updateIcons();
        });
    </script>
    <% } %>
    <main class="<%= typeof isFluid !== 'undefined' && isFluid ? 'flex-grow w-full overflow-hidden flex flex-col px-4 sm:px-6 lg:px-8 py-4' : 'flex-grow w-full py-8 px-4 sm:px-6 lg:px-8' %>">
