<%- include('../partials/header') %>
<div class="mb-6">
    <a href="/admin/labels" class="text-sm text-brand-600 hover:underline mb-2 inline-block">&larr; Volver a Etiquetas</a>
    <h1 class="text-2xl font-semibold text-ink-900 tracking-tight">Editar Etiqueta #<%= label.id %></h1>
</div>

<div class="panel max-w-2xl mx-auto">
    <form action="/admin/labels/<%= label.id %>/edit" method="POST" class="space-y-5">
        
        <div>
            <label class="block text-sm font-medium text-ink-900 mb-1.5">Producto</label>
            <select name="product_id" required class="input-minimal">
                <% products.forEach(p => { %>
                    <option value="<%= p.id %>" <%= label.product_id === p.id ? 'selected' : '' %>><%= p.name %></option>
                <% }) %>
            </select>
        </div>
        
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-ink-900 mb-1.5">Alto (cm)</label>
                <input type="number" step="0.01" name="height" value="<%= label.height %>" required class="input-minimal">
            </div>
            <div>
                <label class="block text-sm font-medium text-ink-900 mb-1.5">Ancho (cm)</label>
                <input type="number" step="0.01" name="width" value="<%= label.width %>" required class="input-minimal">
            </div>
        </div>
        
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-ink-900 mb-1.5">Calidad</label>
                <select name="quality_id" class="input-minimal">
                    <option value="">Ninguna</option>
                    <% qualities.forEach(q => { %>
                        <option value="<%= q.id %>" <%= label.quality_id === q.id ? 'selected' : '' %>><%= q.name %></option>
                    <% }) %>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-ink-900 mb-1.5">Impresora</label>
                <select name="printer_id" class="input-minimal">
                    <option value="">Ninguna</option>
                    <% printers.forEach(p => { %>
                        <option value="<%= p.id %>" <%= label.printer_id === p.id ? 'selected' : '' %>><%= p.name %></option>
                    <% }) %>
                </select>
            </div>
        </div>
        
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-ink-900 mb-1.5">Precio Unitario (Q)</label>
                <input type="number" step="0.01" name="unit_price" value="<%= label.unit_price %>" class="input-minimal">
            </div>
            <div>
                <label class="block text-sm font-medium text-ink-900 mb-1.5">Mano de Obra (%)</label>
                <input type="number" step="1" name="labor_percentage" value="<%= label.labor_percentage %>" required class="input-minimal">
            </div>
        </div>
        
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-ink-900 mb-1.5">Cant. por Hoja</label>
                <input type="number" name="qty_per_sheet" value="<%= label.qty_per_sheet %>" required class="input-minimal">
            </div>
            <div>
                <label class="block text-sm font-medium text-ink-900 mb-1.5">Tipo Papel</label>
                <select name="paper_type" required class="input-minimal">
                    <option value="Matte" <%= label.paper_type === 'Matte' ? 'selected' : '' %>>Matte</option>
                    <option value="Glossy" <%= label.paper_type === 'Glossy' ? 'selected' : '' %>>Glossy</option>
                </select>
            </div>
        </div>

        <div>
            <label class="block text-sm font-medium text-ink-900 mb-1.5">Tags (separados por comas)</label>
            <input type="text" name="tags" value="<%= label.tags || '' %>" placeholder="Ej. Urgente, VIP, Troquelado" class="input-minimal">
        </div>
        
        <div class="pt-4 border-t border-ink-300">
            <button type="submit" class="w-full btn-minimal">Guardar Cambios</button>
            <p class="text-[10px] text-ink-500 text-center mt-3">Nota: Para actualizar las imágenes o documentos asociados, hazlo desde la opción "Actualizar archivos..." en la tabla principal.</p>
        </div>
        
    </form>
</div>
<%- include('../partials/footer') %>
