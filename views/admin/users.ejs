<%- include('../partials/header') %>
<div class="mb-6 flex justify-between items-center">
    <h1 class="text-2xl font-semibold text-ink-900 tracking-tight">Administración de Usuarios</h1>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="panel h-fit md:col-span-1">
        <h2 class="text-sm font-medium text-ink-900 mb-4 pb-3 border-b border-ink-300">Crear Nuevo Usuario</h2>
        <form action="/admin/users" method="POST" class="space-y-4">
            <div>
                <label class="block text-xs font-medium text-ink-900 mb-1">Nombre de Usuario</label>
                <input type="text" name="username" required class="input-minimal" placeholder="Ej. juan_perez">
            </div>
            <div>
                <label class="block text-xs font-medium text-ink-900 mb-1">Contraseña</label>
                <input type="password" name="password" required class="input-minimal" placeholder="••••••••">
            </div>
            <div>
                <label class="block text-xs font-medium text-ink-900 mb-1">Rol / Tipo de Usuario</label>
                <select name="role" required class="input-minimal">
                    <option value="operator">Operador</option>
                    <option value="admin">Administrador</option>
                    <option value="customer">Cliente</option>
                </select>
            </div>
            <div class="pt-2">
                <button type="submit" class="w-full btn-minimal">Crear Usuario</button>
            </div>
        </form>
    </div>

    <div class="panel md:col-span-2">
        <h2 class="text-sm font-medium text-ink-900 mb-4 pb-4 border-b border-ink-300">Roles y Permisos</h2>
    <ul class="divide-y divide-ink-300">
        <% users.forEach(u => { %>
            <li class="py-4 flex items-center justify-between group">
                <div>
                    <p class="text-sm font-medium text-ink-900"><%= u.username %></p>
                    <p class="text-[11px] text-ink-500 uppercase tracking-wider">
                        <%= u.is_admin ? 'Administrador' : (u.is_customer ? 'Cliente' : 'Operador') %>
                    </p>
                </div>
                <div class="flex items-center gap-3">
                    <% if (u.id !== user.id) { %>
                        <form action="/admin/users/<%= u.id %>/role" method="POST" class="inline-flex">
                            <select name="role" onchange="this.form.submit()" class="text-xs rounded border-ink-300 bg-panel text-ink-900 py-1 px-2 focus:ring-0 focus:border-brand-500 transition-colors">
                                <option value="operator" <%= !u.is_admin && !u.is_customer ? 'selected' : '' %>>Operador</option>
                                <option value="admin" <%= u.is_admin ? 'selected' : '' %>>Administrador</option>
                                <option value="customer" <%= u.is_customer ? 'selected' : '' %>>Cliente</option>
                            </select>
                        </form>
                    <% } %>
                    <a href="/admin/users/<%= u.id %>/edit" class="text-xs font-medium text-brand-600 hover:text-brand-800 transition-colors">Editar</a>
                    <% if (u.id !== user.id) { %>
                        <form action="/admin/users/<%= u.id %>/delete" method="POST" class="ajax-delete-form inline-block" onsubmit="return confirm('¿Seguro que deseas eliminar a este usuario?');">
                            <button type="submit" class="text-xs font-medium text-red-500 hover:text-red-700 transition-colors">Eliminar</button>
                        </form>
                    <% } %>
                </div>
            </li>
        <% }) %>
    </ul>
    
    </div>
</div>
<%- include('../partials/footer') %>
