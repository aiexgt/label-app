<%- include('../partials/header') %>
<div class="mb-6 flex justify-between items-center">
    <h1 class="text-2xl font-semibold text-ink-900 tracking-tight">Impresoras</h1>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="panel h-fit">
        <h2 class="text-sm font-medium text-ink-900 mb-4 pb-3 border-b border-ink-300">Añadir Impresora</h2>
        <form action="/admin/printers" method="POST" class="space-y-4">
            <div>
                <label class="block text-xs font-medium text-ink-900 mb-1">Nombre</label>
                <input type="text" name="name" required class="input-minimal">
            </div>
            <div>
                <label class="block text-xs font-medium text-ink-900 mb-1">Tipo / Modelo</label>
                <input type="text" name="type" class="input-minimal" placeholder="Ej. Laser, Inyección...">
            </div>
            <div class="pt-2">
                <button type="submit" class="w-full btn-minimal">Registrar</button>
            </div>
        </form>
    </div>
    <div class="panel">
        <h3 class="text-sm font-medium text-ink-900 mb-4 pb-3 border-b border-ink-300">Directorio de Impresoras</h3>
        <ul class="divide-y divide-ink-300">
            <% if (printers.length > 0) { %>
                <% printers.forEach(printer => { %>
                    <li class="py-4 flex justify-between items-center group">
                        <div>
                            <p class="text-sm font-medium text-ink-900"><%= printer.name %></p>
                            <p class="text-[11px] text-ink-500"><%= printer.type || 'Tipo no especificado' %></p>
                        </div>
                        <form action="/admin/printers/<%= printer.id %>/delete" method="POST" class="ajax-delete-form opacity-0 group-hover:opacity-100 transition-opacity" onsubmit="return confirm('¿Eliminar impresora?');">
                            <button type="submit" class="text-xs text-red-500 hover:text-red-700 font-medium">Eliminar</button>
                        </form>
                    </li>
                <% }) %>
            <% } else { %>
                <li class="py-6 text-xs text-ink-500 text-center bg-surface rounded">No hay impresoras registradas</li>
            <% } %>
        </ul>
    </div>
</div>
<%- include('../partials/footer') %>
