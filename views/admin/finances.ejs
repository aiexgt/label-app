<%- include('../partials/header') %>
<div class="mb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
    <h1 class="text-2xl font-semibold text-ink-900 tracking-tight">Finanzas y Billetera Global</h1>
    
    <!-- Date Filter Form -->
    <form class="flex items-center gap-3 bg-surface p-2 rounded-md border border-ink-300" method="GET" action="/admin/finances">
        <div class="flex items-center gap-2">
            <label class="text-xs font-medium text-ink-500">Desde</label>
            <input type="date" name="start" value="<%= start %>" class="input-minimal py-1 px-2 text-xs">
        </div>
        <div class="flex items-center gap-2">
            <label class="text-xs font-medium text-ink-500">Hasta</label>
            <input type="date" name="end" value="<%= end %>" class="input-minimal py-1 px-2 text-xs">
        </div>
        <button type="submit" class="btn-minimal py-1.5 px-3 text-xs">Filtrar</button>
        <% if (start || end) { %>
            <a href="/admin/finances" class="text-xs text-ink-500 hover:text-ink-900 underline">Limpiar</a>
        <% } %>
    </form>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
        <div class="grid grid-cols-3 gap-4">
            <div class="bg-surface p-5 rounded-lg shadow-subtle border border-ink-300">
                <p class="text-[10px] font-semibold text-ink-500 uppercase tracking-wider mb-2">Por Cobrar (Saldo Restante)</p>
                <p class="text-3xl font-light text-brand-600">Q<%= totalToPay.toFixed(2) %></p>
            </div>
            <div class="bg-surface p-5 rounded-lg shadow-subtle border border-emerald-200">
                <p class="text-[10px] font-semibold text-emerald-600 uppercase tracking-wider mb-2">Ingresos (Billetera Global)</p>
                <p class="text-3xl font-light text-emerald-600">Q<%= totalPaid.toFixed(2) %></p>
            </div>
            <div class="bg-surface p-5 rounded-lg shadow-subtle border border-ink-300">
                <p class="text-[10px] font-semibold text-ink-500 uppercase tracking-wider mb-2">Costo Mano Obra</p>
                <p class="text-3xl font-light text-ink-900">Q<%= totalLabor.toFixed(2) %></p>
            </div>
        </div>

        <div class="panel p-0 overflow-hidden">
            <div class="px-6 py-4 border-b border-ink-300 flex justify-between items-center">
                <h3 class="text-sm font-medium text-ink-900">Historial de Pedidos (Terminados)</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-ink-300">
                    <thead class="bg-surface">
                        <tr>
                            <th class="px-6 py-3 text-left text-[11px] font-semibold text-ink-500 uppercase tracking-wider">Fecha</th>
                            <th class="px-6 py-3 text-left text-[11px] font-semibold text-ink-500 uppercase tracking-wider">ID</th>
                            <th class="px-6 py-3 text-left text-[11px] font-semibold text-ink-500 uppercase tracking-wider">Producto</th>
                            <th class="px-6 py-3 text-right text-[11px] font-semibold text-ink-500 uppercase tracking-wider">Mano de Obra</th>
                            <th class="px-6 py-3 text-right text-[11px] font-semibold text-ink-500 uppercase tracking-wider">Total Generado</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-ink-300">
                        <% if (orders.length > 0) { %>
                            <% orders.forEach(order => { %>
                                <tr class="hover:bg-surface transition-colors">
                                    <td class="px-6 py-4 whitespace-nowrap text-xs text-ink-500">
                                        <% const d = new Date(order.order_date); %>
                                        <%= d.toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-xs font-mono text-ink-500">#<%= order.id %></td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-sm text-ink-900"><%= order.product_name %> <span class="text-ink-500">(<%= order.quantity %>)</span></div>
                                        <% if (order.tags) { %>
                                            <div class="text-[10px] font-medium text-brand-600 mt-0.5"><%= order.tags %></div>
                                        <% } %>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-xs text-ink-500 text-right">
                                        Q<%= order.total_labor_payment %>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-ink-900 text-right">
                                        Q<%= order.total_payment %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="5" class="px-6 py-8 text-center text-sm text-ink-500">No hay pedidos entregados en este período</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <div class="space-y-6">
        <!-- Panel Registrar Transacción -->
        <div class="panel">
            <h2 class="text-sm font-medium text-ink-900 mb-4 pb-4 border-b border-ink-300">Registrar Movimiento</h2>
            <form action="/admin/finances/transaction" method="POST" class="space-y-4">
                <div>
                    <label class="block text-xs font-medium text-ink-900 mb-1">Monto (Q)</label>
                    <input type="number" step="0.01" name="amount" required class="input-minimal" placeholder="Ej. 500 para abono, -100 para retiro">
                    <p class="text-[10px] text-ink-500 mt-1">Usa números negativos para retiros / gastos.</p>
                </div>
                <div>
                    <label class="block text-xs font-medium text-ink-900 mb-1">Descripción</label>
                    <input type="text" name="description" required class="input-minimal" placeholder="Ej. Abono cliente X">
                </div>
                <div class="pt-2">
                    <button type="submit" class="w-full btn-minimal">Guardar Movimiento</button>
                </div>
            </form>
        </div>

        <!-- Tabla Transacciones Globales -->
        <div class="panel p-0 overflow-hidden">
            <div class="px-6 py-4 border-b border-ink-300">
                <h3 class="text-sm font-medium text-ink-900">Billetera (Abonos y Retiros)</h3>
            </div>
            <ul class="divide-y divide-ink-300 max-h-[400px] overflow-y-auto">
                <% if (transactions.length > 0) { %>
                    <% transactions.forEach(t => { %>
                        <li class="p-4 hover:bg-surface transition-colors flex justify-between items-center">
                            <div>
                                <p class="text-xs font-medium text-ink-900"><%= t.description %></p>
                                <% const td = new Date(t.created_at); %>
                                <p class="text-[10px] text-ink-500"><%= td.toLocaleDateString('es-ES') %></p>
                            </div>
                            <span class="text-sm font-semibold <%= parseFloat(t.amount) >= 0 ? 'text-emerald-600' : 'text-red-500' %>">
                                <%= parseFloat(t.amount) >= 0 ? '+' : '' %>Q<%= parseFloat(t.amount).toFixed(2) %>
                            </span>
                        </li>
                    <% }) %>
                <% } else { %>
                    <li class="p-6 text-center text-xs text-ink-500">Sin movimientos</li>
                <% } %>
            </ul>
        </div>
    </div>
</div>
<%- include('../partials/footer') %>
