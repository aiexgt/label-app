<%- include('../partials/header') %>
<div class="mb-6 flex justify-between items-center">
    <h1 class="text-2xl font-semibold text-ink-900 tracking-tight">Etiquetas</h1>
</div>
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="panel lg:col-span-1 h-fit">
        <h2 class="text-sm font-medium text-ink-900 mb-4 pb-3 border-b border-ink-300">Añadir Etiqueta</h2>
        <form action="/admin/labels" method="POST" enctype="multipart/form-data" class="space-y-4">
            <div>
                <label class="block text-xs font-medium text-ink-900 mb-1">Producto</label>
                <select name="product_id" required class="input-minimal">
                    <% products.forEach(p => { %>
                        <option value="<%= p.id %>"><%= p.name %></option>
                    <% }) %>
                </select>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-medium text-ink-900 mb-1">Alto (cm)</label>
                    <input type="number" step="0.01" name="height" required class="input-minimal">
                </div>
                <div>
                    <label class="block text-xs font-medium text-ink-900 mb-1">Ancho (cm)</label>
                    <input type="number" step="0.01" name="width" required class="input-minimal">
                </div>
            </div>
            <div>
                <label class="block text-xs font-medium text-ink-900 mb-1">Calidad</label>
                <select name="quality_id" class="input-minimal">
                    <option value="">Ninguna</option>
                    <% qualities.forEach(q => { %>
                        <option value="<%= q.id %>"><%= q.name %></option>
                    <% }) %>
                </select>
            </div>
            <div>
                <label class="block text-xs font-medium text-ink-900 mb-1">Impresora</label>
                <select name="printer_id" class="input-minimal">
                    <option value="">Ninguna</option>
                    <% printers.forEach(p => { %>
                        <option value="<%= p.id %>"><%= p.name %></option>
                    <% }) %>
                </select>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-medium text-ink-900 mb-1">Precio Und.</label>
                    <input type="number" step="0.01" name="unit_price" value="0" class="input-minimal">
                </div>
                <div>
                    <label class="block text-xs font-medium text-ink-900 mb-1">Mano Obra (%)</label>
                    <input type="number" step="1" name="labor_percentage" value="10" required class="input-minimal">
                </div>
            </div>
            <div>
                <label class="block text-xs font-medium text-ink-900 mb-1">Cant. por Hoja</label>
                <input type="number" name="qty_per_sheet" value="1" required class="input-minimal">
            </div>
            <div class="space-y-3 pt-2">
                <label class="block text-xs font-medium text-ink-900">Archivos</label>
                <input type="file" name="image" accept="image/*" class="block w-full text-xs text-ink-500 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-xs file:font-medium file:bg-brand-50 file:text-brand-600 hover:file:bg-brand-100 cursor-pointer">
                <input type="file" name="word" accept=".doc,.docx" class="block w-full text-xs text-ink-500 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-xs file:font-medium file:bg-brand-50 file:text-brand-600 hover:file:bg-brand-100 cursor-pointer">
                <input type="file" name="pdf" accept=".pdf" class="block w-full text-xs text-ink-500 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-xs file:font-medium file:bg-brand-50 file:text-brand-600 hover:file:bg-brand-100 cursor-pointer">
            </div>
            <div class="pt-3">
                <button type="submit" class="w-full btn-minimal">Guardar Etiqueta</button>
            </div>
        </form>
    </div>
    <div class="panel lg:col-span-2 p-0 overflow-hidden">
        <div class="px-6 py-4 border-b border-ink-300">
            <h3 class="text-sm font-medium text-ink-900">Directorio de Etiquetas</h3>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-ink-300">
                <thead class="bg-surface">
                    <tr>
                        <th class="px-6 py-3 text-left text-[11px] font-semibold text-ink-500 uppercase tracking-wider">ID</th>
                        <th class="px-6 py-3 text-left text-[11px] font-semibold text-ink-500 uppercase tracking-wider">Detalles</th>
                        <th class="px-6 py-3 text-left text-[11px] font-semibold text-ink-500 uppercase tracking-wider">Tamaño/Hoja</th>
                        <th class="px-6 py-3 text-left text-[11px] font-semibold text-ink-500 uppercase tracking-wider">Costo/MO</th>
                        <th class="px-6 py-3 text-left text-[11px] font-semibold text-ink-500 uppercase tracking-wider">Archivos</th>
                        <th class="px-6 py-3 text-right text-[11px] font-semibold text-ink-500 uppercase tracking-wider"></th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-ink-300">
                    <% labels.forEach(label => { %>
                        <tr class="hover:bg-surface transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap text-xs font-mono text-ink-500">#<%= label.id %></td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-ink-900"><%= label.product_name %></div>
                                <div class="text-xs text-ink-500"><%= label.quality_name || '-' %> &bull; <%= label.printer_name || '-' %></div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-xs text-ink-500">
                                <%= label.height %>x<%= label.width %>cm<br><%= label.qty_per_sheet %> unid.
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-xs text-ink-500">
                                Q<%= label.unit_price %> / <%= label.labor_percentage %>%
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex space-x-2.5 text-[11px] text-brand-600 mb-1">
                                    <% if (label.image_path) { %><a href="<%= label.image_path %>" target="_blank" class="hover:underline">IMG</a><% } %>
                                    <% if (label.word_path) { %><a href="<%= label.word_path %>" target="_blank" class="hover:underline">DOC</a><% } %>
                                    <% if (label.pdf_path) { %><a href="<%= label.pdf_path %>" target="_blank" class="hover:underline">PDF</a><% } %>
                                </div>
                                <details class="text-[10px] text-ink-500">
                                    <summary class="cursor-pointer hover:text-ink-900 mb-1">Actualizar archivos...</summary>
                                    <form action="/admin/labels/<%= label.id %>/files" method="POST" enctype="multipart/form-data" class="flex flex-col gap-1 p-1 bg-surface rounded border border-ink-200">
                                        <div class="flex items-center justify-between"><span class="w-6">IMG:</span><input type="file" name="image" accept="image/*" class="w-32"></div>
                                        <div class="flex items-center justify-between"><span class="w-6">DOC:</span><input type="file" name="word" accept=".doc,.docx" class="w-32"></div>
                                        <div class="flex items-center justify-between"><span class="w-6">PDF:</span><input type="file" name="pdf" accept=".pdf" class="w-32"></div>
                                        <button type="submit" class="text-brand-600 font-medium text-left mt-1 hover:underline">Subir</button>
                                    </form>
                                </details>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-xs">
                                <form action="/admin/labels/<%= label.id %>/delete" method="POST" onsubmit="return confirm('¿Eliminar etiqueta?');">
                                    <button type="submit" class="text-red-500 hover:text-red-700 transition-colors">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>
<%- include('../partials/footer') %>
