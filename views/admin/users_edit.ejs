<%- include('../partials/header') %>
<div class="mb-6">
    <a href="/admin/users" class="text-sm text-brand-600 hover:underline mb-2 inline-block">&larr; Volver a Usuarios</a>
    <h1 class="text-2xl font-semibold text-ink-900 tracking-tight">Editar Usuario: <%= targetUser.username %></h1>
</div>

<div class="panel max-w-md mx-auto bg-panel border border-ink-300 rounded-lg shadow-subtle p-6">
    <form action="/admin/users/<%= targetUser.id %>/edit" method="POST" class="space-y-5">
        <div>
            <label class="block text-sm font-medium text-ink-900 mb-1.5">Nombre de Usuario</label>
            <input type="text" name="username" value="<%= targetUser.username %>" required class="input-minimal">
        </div>
        
        <div>
            <label class="block text-sm font-medium text-ink-900 mb-1.5">Nueva Contraseña (dejar en blanco para mantener la actual)</label>
            <input type="password" name="password" class="input-minimal" placeholder="••••••••">
        </div>
        
        <% if (targetUser.id !== user.id) { %>
            <div>
                <label class="block text-sm font-medium text-ink-900 mb-1.5">Rol / Tipo de Usuario</label>
                <select name="role" id="role-select" required class="input-minimal" onchange="toggleBranchSelect()">
                    <option value="operator" <%= !targetUser.is_admin && !targetUser.is_customer && !targetUser.is_manager ? 'selected' : '' %>>Operador</option>
                    <option value="admin" <%= targetUser.is_admin ? 'selected' : '' %>>Administrador</option>
                    <option value="manager" <%= targetUser.is_manager ? 'selected' : '' %>>Encargado</option>
                    <option value="customer" <%= targetUser.is_customer ? 'selected' : '' %>>Cliente</option>
                </select>
            </div>
        <% } else { %>
            <input type="hidden" name="role" id="role-select" value="admin">
        <% } %>
        
        <div id="branch-select-container">
            <label class="block text-sm font-medium text-ink-900 mb-1.5">Sucursal Asignada</label>
            <select name="branch_id" class="input-minimal">
                <option value="">Ninguna / Global</option>
                <% branches.forEach(b => { %>
                    <option value="<%= b.id %>" <%= String(targetUser.branch_id) === String(b.id) ? 'selected' : '' %>><%= b.name %></option>
                <% }) %>
            </select>
        </div>
        
        <div class="pt-4 border-t border-ink-300">
            <button type="submit" class="w-full btn-minimal">Guardar Cambios</button>
        </div>
    </form>
</div>

<script>
    function toggleBranchSelect() {
        const roleSelect = document.getElementById('role-select');
        const container = document.getElementById('branch-select-container');
        if (!roleSelect || !container) return;
        
        const role = roleSelect.value;
        if (role === 'admin') {
            container.style.display = 'none';
            container.querySelector('select').value = '';
        } else {
            container.style.display = 'block';
        }
    }
    document.addEventListener('DOMContentLoaded', toggleBranchSelect);
</script>
<%- include('../partials/footer') %>
